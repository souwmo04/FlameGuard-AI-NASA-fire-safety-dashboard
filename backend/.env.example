# Copy to backend/.env (git-ignored) and fill in. Never commit a real key.

# Ask FlameGuard: any OpenAI-compatible chat API. Default: Groq free tier (no credit card).
# Create a key at https://console.groq.com/keys
FLAMEGUARD_LLM_API_KEY=
FLAMEGUARD_LLM_BASE_URL=https://api.groq.com/openai/v1
FLAMEGUARD_LLM_MODEL=llama-3.3-70b-versatile

# Alternative free option: Google Gemini (key from https://aistudio.google.com/apikey)
# FLAMEGUARD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# FLAMEGUARD_LLM_MODEL=<a Flash model listed in your AI Studio account>

# Questions per client per minute (protects the free quota when deployed)
FLAMEGUARD_ASK_PER_MINUTE=6
