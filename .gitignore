# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# Large NASA documents: re-fetch with scripts/download_flex.py
documents/**/*.pdf
*.part

# Generated artifacts
models/*
!models/.gitkeep
# the deployable final model is small and needed by the dashboard
!models/final_model.joblib
!models/final_model.json
data/interim/*
!data/interim/.gitkeep

# Secrets
.env
.streamlit/secrets.toml

# Experiment run logs (timings only; results are in the CSVs)
reports/**/log_*.txt

# Frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/.env*.local

# Packaging metadata from pip install -e .
*.egg-info/

# Embedding model weights (downloaded by fastembed on first use)
.cache/

# setuptools build output (pip install .)
build/
*.egg-info/
